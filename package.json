{
  "name": "@iridium-group/utils",
  "version": "0.1.0",
  "description": "Pure helpers for Node and browsers: URL parsing, encodings, safe JSON, header handling, timing, and private-address checks.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "author": "Iridium Group contributors",
  "homepage": "https://github.com/Iridium-Group/iridium-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iridium-Group/iridium-utils.git"
  },
  "bugs": {
    "url": "https://github.com/Iridium-Group/iridium-utils/issues"
  },
  "keywords": [
    "utils",
    "url",
    "base64",
    "json",
    "headers",
    "ip-address",
    "proxy"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "import": "./dist/encoding.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./headers": {
      "types": "./dist/headers.d.ts",
      "import": "./dist/headers.js"
    },
    "./timing": {
      "types": "./dist/timing.d.ts",
      "import": "./dist/timing.js"
    },
    "./address": {
      "types": "./dist/address.d.ts",
      "import": "./dist/address.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
